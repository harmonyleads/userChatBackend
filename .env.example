# Application credential embedded in the public page. Not a user password.
# Use a long random value. Comma-separate keys while rotating.
WIDGET_KEYS=replace-with-a-long-random-widget-key

# Server-only secret used to sign session tokens. Never put this in the page.
AUTH_SIGNING_SECRET=replace-with-a-long-random-signing-secret

# Browsers allowed to call this API. Comma-separated origins, no trailing slash.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,https://your-site.example

# Local curl has no Origin header. Keep false in production; browsers send Origin.
AUTH_ALLOW_MISSING_ORIGIN=true

# Supabase session pooler (IPv4). Copy the host from
# Project Settings -> Database -> Session pooler.
# Password is the raw database password. Do not URL-encode it.
# User is postgres.<project ref>, not postgres.
DATABASE_HOST=aws-0-REGION.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_USER=postgres.PROJECT_REF
DATABASE_PASSWORD=YOUR-PASSWORD
DATABASE_NAME=postgres
DATABASE_ENABLED=true
DATABASE_SSL=true
# Applies sql/001_schema.sql on startup. Safe to run more than once.
DATABASE_AUTO_MIGRATE=true

# Public Sarah path code. The browser may also send sarahAuthCode.
# When the allow-list is set, only those codes are accepted.
SARAH_DEFAULT_AUTH_CODE=your-sarah-auth-code
SARAH_ALLOWED_AUTH_CODES=your-sarah-auth-code
SARAH_URL_TEMPLATE=https://staging.cosellus.ai/api/v1/public/hclp/{sarah_auth_code}/sarah/ask

# Optional overrides
# PORT=8080
# LOG_LEVEL=INFO
# PERSISTENCE_WAL_PATH=/tmp/userchat-wal.json
# PERSISTENCE_WAIT_FOR_COMPLETION=true
